{
  "name": "ultra-pro-max-finder",
  "version": "1.0.0",
  "description": "Desktop helper for LinkedIn ProFinder: collects new project requests into a Google Sheet and submits saved proposal and message templates.",
  "private": true,
  "type": "module",
  "main": "src/main/index.js",
  "license": "MIT",
  "author": "pramod",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kneeraazon404/UltraProMaxFinder.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "vitest run --coverage",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "electron-packager . ultra-pro-max-finder --out=dist --overwrite --ignore='^/(?!(?:package[.]json|src|node_modules|LICENSE)(?:/|$))'"
  },
  "dependencies": {
    "@googleapis/sheets": "^18.1.2",
    "bootstrap": "^5.3.8",
    "google-auth-library": "^11.3.2",
    "material-icons": "^1.13.14",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  }
}
